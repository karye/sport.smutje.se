# Mall. Kopiera till .env och fyll i. .env är gitignorerad och ska ha rättigheter 600.

# Signerar sessionscookien (HMAC-SHA256). Minst 32 tecken, aldrig ett hårdkodat värde:
#   openssl rand -hex 32
SESSION_SECRET=

# Signerar exportlänkarna (/api/export/<token>.ics). Roteras om en länk kommer på avvägar.
EXPORT_SECRET=

# Google OAuth-klienten, av typen Web application i Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Måste vara exakt den adress som är registrerad i Google Cloud Console.
# Läses alltid från miljön, aldrig från Host- eller X-Forwarded-Host-huvudet.
REDIRECT_URI=https://sport.smutje.se/auth/callback

# Kommaseparerad lista, epost:roll. Rollerna är foralder och barn.
# Den som står här kommer in; alla andra får 403. Rollen sätts vid första inloggningen.
ALLOWED_EMAILS=

PORT=3011
