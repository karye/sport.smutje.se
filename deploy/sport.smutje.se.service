[Unit]
Description=sport.smutje.se (Bun)
After=network-online.target

[Service]
# Användar-unit: körs som pi och startas utan sudo, som be.smutje.se och classroom-app.
# Ingen User=/Group= — en användar-unit kör alltid som sin ägare.
# Linger är påslaget för pi, alltså startar den vid boot utan inloggning.
WorkingDirectory=/var/www/sport.smutje.se/app
EnvironmentFile=/var/www/sport.smutje.se/.env
ExecStart=/home/pi/.nvm/versions/node/v26.0.0/bin/bun run src/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
